{
  "name": "rimuflix",
  "version": "1.0.6",
  "description": "app de ver filmes e muito mais de graça.",
  "main": "main.js",
  "homepage": "https://github.com/rimublinda/rimuflix",
  "author": {
    "name": "Rimublinda",
    "email": "rimublinda@gmail.com"
  },
  "scripts": {
    "start": "node index.js",
    "start:dev": "nodemon index.js",
    "electron": "electron .",
    "electron:build:win": "electron-builder --win --x64 --publish always",
    "electron:build:linux": "electron-builder --linux deb",
    "electron:build:appimage": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.rimublinda.rimuflix",
    "productName": "Rimuflix",
    "files": [
      "**/*",
      ".env"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Video",
      "icon": "public/img/android-chrome-512x512.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/img/android-chrome-512x512.png"
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.14",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
