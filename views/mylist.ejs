<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/styles/pages/mylist.css" />
    <title>Rimuflix - Minhas Listas</title>
  </head>

  <body>
    <%- include("./partials/header.ejs") %>
    <main class="mylist-container container">
  <div class="mylist-header">
    <div>
      <h1 class="page-title">Minhas Listas</h1>
      <p class="page-subtitle">Organize seus filmes, séries e animes em coleções.</p>
    </div>
    <div class="mylist-actions" id="mylist-actions"></div>
  </div>

  <div class="folders-grid" id="folders-grid"></div>
</main>

    <script type="module">
      import MyList from "/js/pages/mylist.js";
      document.addEventListener("DOMContentLoaded", () => {
        const page = new MyList();
        page.init();
      });
    </script>
  </body>
</html>
