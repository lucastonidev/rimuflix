<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/styles/pages/tutorial.css" />
    <title>Rimuflix - <%= article.title %></title>
  </head>

  <body class="help-page">
    <%- include('partials/header') %>
    <main class="help-container container tutorial-container">
  <a href="/help" class="btn-back-help">
    <i class="fa-solid fa-arrow-left"></i> Voltar para a Central de Ajuda
  </a>

  <article class="tutorial-content-box">
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
      <i class="fa-solid <%= article.icon %>" style="color: var(--accent); font-size: 2.2rem;"></i>
      <h1 style="font-size: 2.2rem; margin: 0; font-weight: 700;"><%= article.title %></h1>
    </div>
    
    <hr style="border-color: rgba(255, 255, 255, 0.08); margin-bottom: 32px;">

    <!-- Renderiza o conteúdo do Markdown convertido -->
    <div class="tutorial-html" style="color: var(--text-secondary); font-size: 1.05rem;">
      <%- content %>
    </div>
  </article>
</main>

<script type="module" src="/js/pages/help.js"></script>
  </body>
</html>