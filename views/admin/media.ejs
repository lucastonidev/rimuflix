<!DOCTYPE html>
<html lang="pt-br">

<head>
  <%- include('../partials/head') %>
    <link rel="stylesheet" href="/styles/admin/pages/admin-media.css">
    <link rel="stylesheet" href="/styles/admin/global.css">
    <title>Gerenciar Mídias | Admin Rimuflix</title>
</head>

<body>
  <%- include('../partials/admin/sidebar') %>
    <!-- Conteúdo Principal -->
    <main class="main-content">
      <header class="header">
        <div class="header-title">
          <h1 class="page-title">Gerenciar Mídias Personalizadas</h1>
        </div>
      </header>
    
      <div class="content-area">
        <div class="card">
          <h2 class="section-title"><i class="fa-solid fa-plus"></i> Adicionar / Atualizar Mídia</h2>
    
          <!-- ========================================== -->
          <!-- PREVIEW DA MÍDIA (Controlado pelo JS)      -->
          <!-- ========================================== -->
          <div id="media-preview" class="media-preview">
            <img id="preview-image" src="" alt="Capa da Mídia">
            <div class="media-preview-info">
              <h4 id="preview-title">Título</h4>
              <p>Mídia localizada com sucesso no TMDB.</p>
              <span id="preview-type">Filme</span>
            </div>
          </div>
    
          <!-- ========================================== -->
          <!-- FORMULÁRIO (Controlado pelo JS)            -->
          <!-- ========================================== -->
          <form id="form-add-media">
            <div class="grid grid-cols-2">
    
              <!-- Seleção do Tipo -->
              <div class="form-group">
                <label for="media_type" class="form-label">Tipo de Mídia</label>
                <div class="select-wrapper">
                  <select id="media_type" class="form-control" required>
                    <option value="movie">Filme</option>
                    <option value="tv">Série</option>
                  </select>
                  <i class="fa-solid fa-chevron-down"></i>
                </div>
              </div>
    
              <!-- Input do ID (Dispara a busca no TMDB) -->
              <div class="form-group">
                <label for="tmdb_id" class="form-label">ID do TMDB</label>
                <input type="text" id="tmdb_id" class="form-control" placeholder="Ex: 533535" required>
              </div>
    
            </div>
    
            <!-- Input do Título (Autopreenchido) -->
            <div class="form-group">
              <label for="title" class="form-label">Título da Mídia</label>
              <input type="text" id="title" class="form-control" placeholder="Será preenchido automaticamente..." required>
            </div>

            <div class="form-group">
              <label for="season_number" class="form-label">Temporada:</label>
              <input type="text" id="season_number" class="form-control" placeholder="Qual é a temporada quer se quer adicionar?" required>
            </div>

            <div class="form-group">
              <label for="episode_number" class="form-label">Episódio:</label>
              <input type="text" id="episode_number" class="form-control" placeholder="Qual é o episodio que se quer adicionar" required>
            </div>
    
            <!-- Input de Torrents -->
            <div class="form-group">
              <label for="torrent_links" class="form-label">Links Torrent (Cole os Magnets separados por vírgula ou
                Enter)</label>
              <textarea id="torrent_links" class="form-control" rows="4" placeholder="magnet:?xt=urn:btih:..."></textarea>
            </div>
    
            <!-- Input de Drive/Hospedagem -->
            <div class="form-group">
              <label for="drive_links" class="form-label">Links Externos / Drive (Separados por vírgula ou Enter)</label>
              <textarea id="drive_links" class="form-control" rows="4"
                placeholder="https://drive.google.com/file/..."></textarea>
            </div>
    
            <!-- Botões de Ação -->
            <div class="flex justify-end gap-4 mt-4">
              <button type="reset" class="btn btn-secondary">Limpar</button>
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save"></i> Salvar no Banco</button>
            </div>
          </form>
    
        </div>
      </div>
    </main>

    <script type="module" src="/js/admin/media.js"></script>
</body>

</html>