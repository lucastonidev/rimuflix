<!DOCTYPE html>
<html lang="pt-br">
<head>

  <%- include('partials/head') %>

  <link rel="stylesheet" href="/styles/pages/playlist.css">
  <title>Playlist - Rimuflix</title>  
</head>
<body class="hidde-scroll">
  
  <%- include('partials/header') %>

  <main class="playlist-page">
    <!-- 1. HERO SECTION: Capa borrada, Título, Criador e Botões principais -->
    <section id="playlist-hero" class="playlist-hero">
      <div class="hero-loader">
        <i class="fa-solid fa-spinner fa-spin fa-2x"></i>
      </div>
    </section>

    <!-- 2. CONTEÚDO: Estatísticas e Grid de Mídias -->
    <div class="playlist-content">
      
      <!-- Estatísticas Detalhadas -->
      <div id="playlist-stats" class="playlist-stats-bar">
        <!-- Injetado via JS -->
      </div>

      <!-- Controles da Lista (Busca Interna e Filtros) -->
      <div class="playlist-controls">
        <div class="search-internal">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="input-filter-list" placeholder="Buscar nesta lista...">
        </div>
        
        <div class="playlist-controls-actions">
          <span id="items-count-label">Carregando...</span>
          <button class="btn-secondary playlist-add-button" id="btn-add-playlist-items" type="button" hidden>
            <i class="fa-solid fa-plus"></i> Adicionar títulos
          </button>
        </div>
      </div>

      <!-- Grid de Mídias -->
      <div id="playlist-grid" class="media-grid">
        <!-- Cards injetados via JS -->
      </div>

    </div>
  </main>

  <div class="playlist-add-overlay" id="playlist-add-overlay" hidden>
    <div class="playlist-add-modal" role="dialog" aria-modal="true" aria-labelledby="playlist-add-title">
      <div class="playlist-add-header">
        <h2 id="playlist-add-title">Adicionar títulos</h2>
        <button class="playlist-close" id="close-playlist-add" type="button" aria-label="Fechar">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <form class="playlist-add-search" id="playlist-add-form">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input id="playlist-add-input" type="search" placeholder="Buscar filmes ou séries..." autocomplete="off">
        <button class="btn-primary" type="submit">Buscar</button>
      </form>
      <div class="playlist-add-results" id="playlist-add-results">
        <p class="playlist-add-message">Busque um filme ou uma série para adicionar.</p>
      </div>
    </div>
  </div>

  <script type="module" src="/js/pages/playlist.js"></script>
</body>
</html>